[
  {"t": 9.8, "end": 13.3, "text": "有人說男孩不能掉眼淚"},
  {"t": 14.0, "end": 17.8, "text": "有人說女孩不必太勇敢"},
  {"t": 17.8, "end": 21.9, "text": "標籤一張一張 貼在我身上"},
  {"t": 21.9, "end": 25.8, "text": "遮住了我本來的模樣"},
  {"t": 25.8, "end": 30.0, "text": "如果顏色 沒有性別"},
  {"t": 30.0, "end": 34.0, "text": "如果夢想 不分你我"},
  {"t": 34.6, "end": 38.0, "text": "撕下標籤 我就是我"},
  {"t": 38.8, "end": 43.1, "text": "溫柔或勇敢 由我選擇"},
  {"t": 43.1, "end": 47.3, "text": "不必像誰 不被誰定義"},
  {"t": 47.3, "end": 50.6, "text": "我的樣子 我自己說"},
  {"t": 50.6, "end": 53.0, "text": "我自己說"},
